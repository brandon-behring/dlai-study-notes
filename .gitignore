# Build outputs
dist/
dist-pdf/

# Generated artifacts (regenerate cheaply on any Node env — no special toolchain)
src/data/labels.json
src/data/references.json
public/notebooks/**/*.html
# NOTE: public/figures/**/*.svg are COMMITTED (not ignored) — build-figures needs
# pdflatex/dvisvgm which the Cloudflare build env lacks, so the built SVGs ship in
# the repo. (Phase-2 deploy: make build:figures gracefully skip when LaTeX is absent.)

# Anki output
dist/anki/

# TikZ build artifacts (PDFs from .tex compilation in figures/)
figures/**/*.pdf
figures/**/*.aux
figures/**/*.log
figures/**/*.out
figures/**/*.synctex.gz

# Node / npm
node_modules/
npm-debug.log*

# Astro
.astro/

# Environment
.env
.env.local
.env.*.local

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Pagefind
pagefind/
