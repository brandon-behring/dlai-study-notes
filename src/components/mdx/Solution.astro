---
---
<details class="solution" open>
  <summary class="solution-summary">Solution</summary>
  <div class="solution-body"><slot /></div>
</details>

<style>
  .solution {
    border-left: 3px solid var(--color-solution, #38a169);
    padding: 0.75rem 1.25rem;
    margin: 1rem 0;
    background: var(--color-bg-subtle, #f0fff4);
    border-radius: 0 4px 4px 0;
  }
  .solution-summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-solution, #38a169);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }
  .solution-body { margin-top: 0.75rem; }
  .solution-body :global(p:last-child) { margin-bottom: 0; }
</style>
