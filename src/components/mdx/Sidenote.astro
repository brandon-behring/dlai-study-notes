---
const { category } = Astro.props;
const labels = {
  interview: 'Interview',
  warning: 'Warning',
  pattern: 'Pattern',
  formula: 'Formula',
  practice: 'Practice',
  crossref: 'Cross-ref',
};
const label = labels[category] || category;
---
<aside class={`sidenote sidenote--${category}`} role="note">
  <span class="sidenote-label">{label}</span>
  <span class="sidenote-body"><slot /></span>
</aside>

<style>
  .sidenote {
    display: block;
    border-left: 2px solid var(--color-sidenote, #cbd5e0);
    padding: 0.4rem 0.75rem;
    margin: 1rem 0;
    font-size: 0.92em;
    color: var(--color-text-secondary, #4a5568);
  }
  .sidenote-label {
    display: inline-block;
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: 0.5rem;
    color: var(--color-sidenote-label, #4a5568);
  }
  .sidenote--interview { border-left-color: var(--color-interview, #805ad5); }
  .sidenote--interview .sidenote-label { color: var(--color-interview, #805ad5); }
  .sidenote--warning { border-left-color: var(--color-warning, #d69e2e); }
  .sidenote--warning .sidenote-label { color: var(--color-warning, #d69e2e); }
  .sidenote--pattern { border-left-color: var(--color-pattern, #2b6cb0); }
  .sidenote--pattern .sidenote-label { color: var(--color-pattern, #2b6cb0); }
  .sidenote--formula { border-left-color: var(--color-formula, #553c9a); }
  .sidenote--formula .sidenote-label { color: var(--color-formula, #553c9a); }
  .sidenote--practice { border-left-color: var(--color-practice, #38a169); }
  .sidenote--practice .sidenote-label { color: var(--color-practice, #38a169); }
  .sidenote--crossref { border-left-color: var(--color-crossref, #718096); }
  .sidenote--crossref .sidenote-label { color: var(--color-crossref, #718096); }
</style>
