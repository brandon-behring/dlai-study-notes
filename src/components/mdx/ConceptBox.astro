---
const { title } = Astro.props;
---
<aside class="callout callout--concept">
  {title && <h4 class="callout-title">{title}</h4>}
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout--concept {
    /* Scaffold tip/green family. --warm-green-tint auto-flips with --paper in
       dark mode; --color-text flips too. (Was pinned to a light #f0fff4 because
       --color-callout-concept was never defined → unreadable in dark mode.) */
    border-left: 3px solid var(--callout-tip, #38a169);
    background: var(--warm-green-tint, #f0fff4);
    color: var(--color-text, #1a202c);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 4px 4px 0;
  }
  .callout-title {
    margin: 0 0 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--callout-tip, #38a169);
  }
  .callout-body :global(p:last-child) { margin-bottom: 0; }

  /* Dark mode: brighten the green title for WCAG-AA contrast on the dark tint. */
  :root[data-theme="dark"] .callout--concept .callout-title { color: color-mix(in srgb, var(--warm-green) 62%, white); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .callout--concept .callout-title { color: color-mix(in srgb, var(--warm-green) 62%, white); }
  }
</style>
