---
const { title } = Astro.props;
---
<aside class="callout callout--narrative">
  {title && <h4 class="callout-title">{title}</h4>}
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout--narrative {
    /* Scaffold info/blue family. --warm-blue-tint auto-flips with --paper in
       dark mode; --color-text flips too. (Was pinned to a light #f0f7ff because
       --color-callout-narrative was never defined → unreadable in dark mode.) */
    border-left: 3px solid var(--callout-info, #2b6cb0);
    background: var(--warm-blue-tint, #f0f7ff);
    color: var(--color-text, #1a202c);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 4px 4px 0;
  }
  .callout-title {
    margin: 0 0 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    /* --color-heading is the scaffold's blue, already brightened in dark mode. */
    color: var(--color-heading, #2b6cb0);
  }
  .callout-body :global(p:last-child) { margin-bottom: 0; }
</style>
