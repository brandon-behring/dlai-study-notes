---
/**
 * Figure — TikZ-compiled SVG or imported image, with caption.
 * Wire to tooling/build-figures output at public/figures/<book>/<name>.svg.
 */
const { src, alt, caption } = Astro.props;
---
<figure class="figure">
  <img src={src} alt={alt || caption || ''} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure { margin: 1.5rem 0; text-align: center; }
  .figure img { max-width: 100%; height: auto; }
  figcaption {
    font-size: 0.88em; color: var(--color-text-secondary, #4a5568);
    margin-top: 0.5rem; text-align: left;
  }
</style>
