---
const { title } = Astro.props;
---
<aside class="callout callout--pipeline">
  {title && <h4 class="callout-title">{title}</h4>}
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout--pipeline {
    /* Scaffold insight/gold family. --warm-gold-tint auto-flips with --paper in
       dark mode; --color-text flips too. (Was pinned to a light #fffaf0 because
       --color-callout-pipeline was never defined → unreadable in dark mode.) */
    border-left: 3px solid var(--callout-insight, #d69e2e);
    background: var(--warm-gold-tint, #fffaf0);
    color: var(--color-text, #1a202c);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 4px 4px 0;
  }
  .callout-title {
    margin: 0 0 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    /* a11y (#80): the gold title text failed WCAG-AA (2.49 light); the gold hue
       is carried by the left border. --color-heading is high-contrast AND
       theme-aware, so it reads in both modes with no dark override. */
    color: var(--color-heading);
  }
  .callout-body :global(p:last-child) { margin-bottom: 0; }
</style>
