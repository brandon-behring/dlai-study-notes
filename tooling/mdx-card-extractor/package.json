  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-mdx": "^3.1.0",
    "remark-math": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse-frontmatter": "^1.0.3",
    "unist-util-visit": "^5.0.0",
    "anki-apkg-export": "^4.0.3",
    "yaml": "^2.6.0"
  }
}
